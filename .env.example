# Copy this file to `.env` and fill in the values for your local setup.
# Never commit a real `.env` file: `.env` is already ignored by git.
# Only variable NAMES belong in this file. Secrets, API keys, tokens,
# database credentials and JWT secrets must stay in your local `.env`
# or in your deployment platform's secret store.
#
# Additional groups (session, AI provider, email) will be added
# here in the phase that introduces them, never before.

# Runtime
NODE_ENV=development
PORT=3000

# Database
# PostgreSQL connection string for the Supabase project, in the form
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE. The real value belongs in
# `.env` or in your deployment platform's secret store, never in this file.
DATABASE_URL=
