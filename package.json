{
  "name": "ai-study-backend",
  "version": "0.1.0",
  "description": "Backend service for the AI Study Companion platform: a study-workflow owned backend with provider-independent AI integrations.",
  "type": "commonjs",
  "main": "src/app.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:status": "sequelize db:migrate:status",
    "db:migrate:generate": "sequelize migration:generate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:seed:all": "sequelize db:seed:all",
    "db:seed:undo": "sequelize db:seed:undo",
    "db:seed:generate": "sequelize seed:generate"
  },
  "keywords": [
    "ai",
    "study",
    "education",
    "express",
    "backend"
  ],
  "author": "open-source-collabs",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.5"
  }
}
